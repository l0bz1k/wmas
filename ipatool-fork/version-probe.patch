+
+// infoPlistDeviceFamilies names the UIDeviceFamily values an app declares.
+func infoPlistDeviceFamilies(metadata map[string]interface{}) string {
+	values, _ := metadata["UIDeviceFamily"].([]interface{})
+	names := make([]string, 0, len(values))
+
+	for _, value := range values {
+		switch fmt.Sprint(value) {
+		case "1":
+			names = append(names, "iphone")
+		case "2":
+			names = append(names, "ipad")
+		case "3":
+			names = append(names, "appletv")
+		case "4":
+			names = append(names, "watch")
+		case "7":
+			names = append(names, "vision")
+		}
+	}
+
+	return strings.Join(names, ",")
+}
