diff --git a/cmd/profile.go b/cmd/profile.go
new file mode 100644
index 0000000..9ca7bfa
--- /dev/null
+++ b/cmd/profile.go
@@ -0,0 +1,37 @@
+package cmd
+
+import (
+	"fmt"
+	"path/filepath"
+	"regexp"
+
+	"github.com/majd/ipatool/v2/pkg/util/operatingsystem"
+)
+
+// ProfileEnvironmentVariable selects an isolated account profile. Unset keeps
+// the stock single-account storage, so an existing session is the default
+// profile.
+const ProfileEnvironmentVariable = "IPATOOL_PROFILE"
+
+var profileNamePattern = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)
+
+// resolveProfile namespaces the two places a session lives: the state
+// directory (cookie jar, file keyring) and the keychain service that holds the
+// account, anisette and kbsync entries.
+func resolveProfile(os operatingsystem.OperatingSystem, stateDirectory string) (string, string, error) {
+	profile := os.Getenv(ProfileEnvironmentVariable)
+	if profile == "" {
+		return stateDirectory, KeychainServiceName, nil
+	}
+
+	if !profileNamePattern.MatchString(profile) {
+		return "", "", fmt.Errorf("invalid %s %q: use letters, digits, dot, underscore or hyphen", ProfileEnvironmentVariable, profile)
+	}
+
+	directory := filepath.Join(stateDirectory, "profiles", profile)
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		return "", "", fmt.Errorf("failed to create profile directory: %w", err)
+	}
+
+	return directory, KeychainServiceName + "." + profile, nil
+}
